datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  role      Role     @default(SHIPPER)
  
  approved        Boolean   @default(false)
  rejectionReason String?   @db.Text
  approvedAt      DateTime?
  rejectedAt      DateTime?
  
  shipmentsCreated    Shipment[]            @relation("CreatedBy")
  shipmentsAsDriver   Shipment[]            @relation("Driver")
  trackingUpdates     ShipmentTracking[]    @relation("UpdatedBy")
  shipmentApplications ShipmentApplication[] @relation("AppliedBy")
  vehicleInfo         VehicleInfo?          @relation("OwnerOf")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([approved])
  @@index([role])
}

enum Role {
  ADMIN
  SHIPPER
  DRIVER
}

model VehicleInfo {
  id          String   @id @default(cuid())
  driverId    String   @unique
  driver      User     @relation("OwnerOf", fields: [driverId], references: [id], onDelete: Cascade)
  
  vehicleType String
  licensePlate String
  capacity    Float
  documentUrl String?
  verified    Boolean @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([driverId])
}

model Shipment {
  id        String   @id @default(cuid())
  
  fromCity  String   @db.VarChar(255)
  toCity    String   @db.VarChar(255)
  weight    Float
  value     Decimal  @db.Decimal(10, 2)
  items     Json
  
  status    ShipmentStatus @default(AVAILABLE)
  
  createdById String
  createdBy    User   @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  
  driverId  String?
  driver    User?    @relation("Driver", fields: [driverId], references: [id], onDelete: SetNull)
  
  createdAt         DateTime  @default(now())
  expectedDelivery  DateTime?
  deliveredAt       DateTime?
  
  tracking     ShipmentTracking[]
  applications ShipmentApplication[] @relation("AppliedFor")
  
  updatedAt DateTime @updatedAt
  
  @@index([status])
  @@index([driverId])
  @@index([createdById])
  @@index([createdAt])
}

enum ShipmentStatus {
  AVAILABLE
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

model ShipmentApplication {
  id            String   @id @default(cuid())
  
  shipmentId    String
  shipment      Shipment @relation("AppliedFor", fields: [shipmentId], references: [id], onDelete: Cascade)
  
  driverId      String
  driver        User     @relation("AppliedBy", fields: [driverId], references: [id], onDelete: Cascade)
  
  status        ApplicationStatus @default(PENDING)
  
  proposedPrice Decimal?          @db.Decimal(10, 2)
  message       String?           @db.Text
  
  appliedAt     DateTime @default(now())
  respondedAt   DateTime?
  
  @@unique([shipmentId, driverId])
  @@index([shipmentId])
  @@index([driverId])
  @@index([status])
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model ShipmentTracking {
  id        String   @id @default(cuid())
  
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  
  status    TrackingStatus
  location  String   @db.VarChar(255)
  latitude  Float?
  longitude Float?
  notes     String?  @db.Text
  
  updatedById String
  updatedBy    User   @relation("UpdatedBy", fields: [updatedById], references: [id], onDelete: Cascade)
  
  updatedAt DateTime @default(now())
  
  @@index([shipmentId])
  @@index([updatedAt])
}

enum TrackingStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  FAILED
}